# Backup de produccion de HRMotor
# Copia este archivo como backup.env en el servidor y rellena los valores.
# No subas backup.env con credenciales a GitHub.

# Ruta local donde se generan los ficheros de backup antes de subir el .age
BACKUP_LOCAL_PATH=/opt/hrmotor/backups

# Destino remoto rclone. Ejemplo: onedrive:Departamento IT/Backups APP
BACKUP_REMOTE_TARGET="onedrive:Departamento IT/Backups APP"

# Retencion local y remota en dias
BACKUP_RETENTION_DAYS=30

# Clave publica age para cifrar el backup
BACKUP_AGE_RECIPIENT="age1RELLENAR_AQUI"

# Servicio MariaDB en docker-compose.production.yml
BACKUP_DB_SERVICE="db"

# Credenciales de la base de datos de produccion
BACKUP_DB_NAME="RELLENAR"
BACKUP_DB_USER="RELLENAR"
BACKUP_DB_PASSWORD="RELLENAR"

# Opcional: ruta alternativa del compose si cambias el nombre o la ubicacion
# BACKUP_COMPOSE_FILE="/opt/hrmotor/app-hr-motor/docker-compose.production.yml"

# Opcional: ruta al fichero de entorno dedicado del backup
# BACKUP_ENV_FILE="/etc/hrmotor/backup.env"
